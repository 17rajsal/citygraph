# CityGraph Frontend Environment Configuration
# Set VITE_API_URL to your Render backend URL in Vercel Environment Variables.
# Example: https://citygraph-backend-xxxx.onrender.com
VITE_API_URL=http://127.0.0.1:8000

# Set to 'true' to display the quick demo credential button on login
VITE_ENABLE_DEMO_LOGIN=true
