# CityGraph Project Environment Configuration Template
# ========================================================
# Copy this template to .env for local development.
# In production, set these variables in Render / Vercel dashboard.

# --- Backend Configuration (Render) ---
ENVIRONMENT=development
SECRET_KEY=change_me_to_a_secure_random_string_at_least_32_chars_long
DATABASE_URL=sqlite:///./citygraph.db
CORS_ORIGINS=http://localhost:5173,https://citygraph.vercel.app
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ENABLE_DOCS=true
SEED_DEFAULT_USER=false
INITIAL_ADMIN_EMAIL=admin@citygraph.org
INITIAL_ADMIN_PASSWORD=

# --- Frontend Configuration (Vercel) ---
VITE_API_URL=http://127.0.0.1:8000
VITE_ENABLE_DEMO_LOGIN=true
